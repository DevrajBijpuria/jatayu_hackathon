# Copy to .env.local and fill in values. Never commit .env.local.

# Auth.js secret — generate with: openssl rand -hex 32
AUTH_SECRET=change_me_generate_with_openssl_rand_hex_32

# Keycloak OIDC (only needed when NEXT_PUBLIC_ENABLE_SSO=true)
OIDC_CLIENT_ID=truthguard-web
OIDC_ISSUER=http://localhost:8080/realms/truthguard
# No client secret — public PKCE client

# TruthGuard backend
TRUTHGUARD_API_URL=http://localhost:8000

# Feature flags
NEXT_PUBLIC_ENABLE_SSO=false

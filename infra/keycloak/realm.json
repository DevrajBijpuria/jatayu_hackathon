{
  "realm": "truthguard",
  "displayName": "TruthGuard",
  "enabled": true,
  "loginTheme": "truthguard",
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "smtpServer": {
    "host": "${KC_SMTP_HOST}",
    "port": "${KC_SMTP_PORT}",
    "from": "${KC_SMTP_FROM}",
    "fromDisplayName": "TruthGuard"
  },
  "clients": [
    {
      "clientId": "truthguard-web",
      "name": "TruthGuard Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "audience-truthguard-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "truthguard-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "truthguard-api",
      "name": "TruthGuard API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "truthguard-admin",
      "name": "TruthGuard user management (service account)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "groups": [
    {"name": "tg-employees", "path": "/tg-employees"},
    {"name": "tg-compliance", "path": "/tg-compliance"},
    {"name": "tg-board", "path": "/tg-board"},
    {"name": "tg-admins", "path": "/tg-admins"}
  ],
  "users": [
    {
      "username": "service-account-truthguard-admin",
      "enabled": true,
      "serviceAccountClientId": "truthguard-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-groups"]
      }
    }
  ]
}

LLM_BASE_URL=https://api.groq.com/openai/v1     # or http://localhost:11434/v1 for Ollama
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL_SMALL=llama-3.1-8b-instant              # names differ per provider; set to what your provider offers
LLM_MODEL_LARGE=llama-3.3-70b-versatile
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
DUCKDB_PATH=data/truthguard.duckdb
INDEX_DIR=data/index

# Feature flags (see §2.1)
ENABLE_HINDI=true
ENABLE_CONNECTORS=false
ENABLE_SSO=false

# Connectors (only when ENABLE_CONNECTORS=true)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
MAILBOX_USER=circulars@example.org
MAIL_FOLDER=Circulars
IMAP_HOST=                      # only if not using Microsoft Graph
IMAP_USER=
IMAP_PASSWORD=
CONNECTOR_POLL_MINUTES=15

# SSO (only when ENABLE_SSO=true)
OIDC_ISSUER=http://localhost:8080/realms/truthguard
OIDC_CLIENT_ID=truthguard-web
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=truthguard-api
GROUP_TO_ACCESS={"tg-employees":["all"],"tg-compliance":["all","compliance"],"tg-board":["all","compliance","board"]}
ADMIN_GROUP=tg-admins                 # admin rights only; grants no document access by itself

# Keycloak (docker compose reads these from .env)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=               # Keycloak console password; pick your own
KC_ADMIN_CLIENT_ID=truthguard-admin
KC_ADMIN_CLIENT_SECRET=                # service-account secret, e.g. openssl rand -hex 24; also used by the API

# User management
SEND_PASSWORD_EMAIL=false              # true: Keycloak emails a set-password link (Mailpit: http://localhost:8025)
BOOTSTRAP_ADMIN_EMAIL=                 # make bootstrap-admin creates this first admin
BOOTSTRAP_ADMIN_NAME=TruthGuard Admin
